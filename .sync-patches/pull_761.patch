index 2d5426ac6..903ec96ea 100644
--- a/clock-arch.h
+++ b/clock-arch.h
@@ -36,7 +36,7 @@
 
 #include <stdint.h>
 
-typedef uint32_t clock_time_t;
+typedef uint16_t clock_time_t;
 #define CLOCK_CONF_SECOND SYS_TICK_HZ
 
 #endif /* __CLOCK_ARCH_H__ */
