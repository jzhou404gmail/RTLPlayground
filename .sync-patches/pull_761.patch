From 7d95f05ad56aed6b0bbd90dc1ebf892813b62d9f Mon Sep 17 00:00:00 2001
From: DrDoof <8052722+DrDoof@users.noreply.github.com>
Date: Fri, 30 Oct 2026 16:19:05 +0100
Subject: [PATCH 15/20] lacp: step the state machines from a timer

lacp_timers() kept a byte of the tick count and caught up with
TICKS_DUE; it now steps on a periodic timer started by the engine,
reset by its interval so a stall still catches up LACP_CATCH_UP steps.
---
 rtl837x_lacp.c | 10 +++++-----
 test/Makefile  |  2 +-
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/rtl837x_lacp.c b/rtl837x_lacp.c
index c8d6b1d6b..2d3c8f2a2 100644
--- a/rtl837x_lacp.c
+++ b/rtl837x_lacp.c
@@ -16,6 +16,7 @@
 #include "rtl837x_port.h"
 #include "uip.h"
 #include "machine.h"
+#include "timer.h"
 
 extern __code const struct machine machine;
 extern __xdata struct machine_runtime machine_detected;
@@ -97,8 +98,7 @@ __xdata uint8_t  lacp_ntt[10];
 
 #define LACP_TICK_STEP	(SYS_TICK_HZ / 50)
 #define LACP_CATCH_UP	8
-__xdata uint8_t lacp_tick_last;
-extern volatile __xdata uint32_t ticks;
+static __xdata struct timer lacp_step_timer;
 
 __xdata uint16_t lacp_lag_ports[LACP_NUM_LAGS];
 __xdata uint8_t  lacp_port_lag[10];
@@ -346,8 +346,8 @@ static void lacp_step(void)
 void lacp_timers(void) __banked
 {
 	uint8_t n = LACP_CATCH_UP;
-	while (n-- && TICKS_DUE(lacp_tick_last, LACP_TICK_STEP)) {
-		lacp_tick_last += LACP_TICK_STEP;
+	while (n-- && timer_expired(&lacp_step_timer)) {
+		timer_reset(&lacp_step_timer);
 		lacp_step();
 	}
 }
@@ -388,7 +388,7 @@ static uint8_t lacp_any_lag(void)
 
 static void lacp_engine_on(void)
 {
-	lacp_tick_last = (uint8_t)ticks;
+	timer_set(&lacp_step_timer, LACP_TICK_STEP);
 	lacpEnabled = 1;
 	trap_rma_set(RTL837X_RMA2_CONF, RTL837X_RMA_ACT_TRAP);
 }
diff --git a/test/Makefile b/test/Makefile
index 6278fe33f..b0599a548 100644
--- a/test/Makefile
+++ b/test/Makefile
@@ -70,7 +70,7 @@ $(BUILDDIR)/test_page_json: test_page_json.c $(TABLE_ENV) hw_mock.h | $(BUILDDIR
 	$(CC) $(CFLAGS) $(filter %.c,$^) -o $@ $(LDFLAGS)
 
