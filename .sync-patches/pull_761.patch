From 47aa26fdec0deee548d36d40626706fed86e4679 Mon Sep 17 00:00:00 2001
From: DrDoof <8052722+DrDoof@users.noreply.github.com>
Date: Fri, 30 Oct 2026 16:19:05 +0100
Subject: [PATCH 16/20] lldp: send on a timer

lldp_tick() kept its own second counter off the tick count and compared
it to the interval; it now waits on a periodic timer, with the interval
spelled once in ticks. The TTL still follows the interval in seconds.
---
 rtl837x_lldp.c | 16 +++++-----------
 rtl837x_lldp.h |  1 +
 2 files changed, 6 insertions(+), 11 deletions(-)

diff --git a/rtl837x_lldp.c b/rtl837x_lldp.c
index ebf8387b9..e2757deb8 100644
--- a/rtl837x_lldp.c
+++ b/rtl837x_lldp.c
@@ -10,31 +10,25 @@
 #include "uip/uip.h"
 #include "machine.h"
 #include "version.h"
+#include "timer.h"
 
 extern __xdata bool lldp_enabled;
 extern __code const struct machine machine;
 
-extern volatile __xdata uint32_t ticks;
-
-__xdata uint8_t lldp_tick_last;
-__xdata uint8_t lldp_seconds;
+static __xdata struct timer lldp_timer;
 __xdata uint16_t lldp_logical_port_status = 0xffff;
 
 void lldp_init(void) __banked
 {
-    lldp_tick_last = (uint8_t)ticks;
-    lldp_seconds = 0;
+    timer_set(&lldp_timer, LLDP_TX_INTERVAL_TICKS);
 }
 
 void lldp_tick(void) __banked
 {
-    if (!TICKS_DUE(lldp_tick_last, SYS_TICK_HZ))
+    if (!timer_expired(&lldp_timer))
         return;
-    lldp_tick_last += SYS_TICK_HZ;
 
-    if (++lldp_seconds < LLDP_TX_INTERVAL_S)
-        return;
-    lldp_seconds = 0;
+    timer_reset(&lldp_timer);
 
     if (lldp_enabled)
         lldp_send();
diff --git a/rtl837x_lldp.h b/rtl837x_lldp.h
index f7b866151..4089bd4ec 100644
--- a/rtl837x_lldp.h
+++ b/rtl837x_lldp.h
@@ -8,6 +8,7 @@
 #define LLDP_ETHERTYPE_LENGTH 2
 #define LLDP_MAX_FRAME       256
 #define LLDP_TX_INTERVAL_S   30
+#define LLDP_TX_INTERVAL_TICKS (LLDP_TX_INTERVAL_S * SYS_TICK_HZ)
 #define LLDP_HOLD_MULTIPLIER 4
 
 #define LLDP_PORT_ID_TLV_TYPE 2

