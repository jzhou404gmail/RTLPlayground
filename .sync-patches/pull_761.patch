 clock.h           | 27 ---------------------------
 test/Makefile     |  5 +++++
 test/test_timer.c | 44 ++++++++++++++++++++++++++++++++++++++++++++
 timer.c           | 12 ++++++++++++
 5 files changed, 62 insertions(+), 28 deletions(-)
 create mode 100644 test/test_timer.c

