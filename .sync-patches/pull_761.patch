From a6fc5f7f0e68463f2b8153ab16ba42b811e8db8b Mon Sep 17 00:00:00 2001
From: DrDoof <8052722+DrDoof@users.noreply.github.com>
Date: Fri, 30 Oct 2026 16:19:05 +0100
Subject: [PATCH 02/20] timer: make the timers usable from any bank

clock_time() returned the 32-bit tick counter with a plain load, which
the timer interrupt can split between two bytes, so read it again until
the low byte agrees: every tick changes it, and the low byte is loaded
first. CLOCK_SECOND follows SYS_TICK_HZ instead of a fixed 100, which
was half a second at our tick rate. The timer functions lived in BANK1
and could only be called from there; they are small and called from
every bank and from the main loop, so they move to the home bank.
---
 clock-arch.h | 2 +-
 clock.h      | 7 ++++++-
 timer.c      | 3 ---
 3 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/clock-arch.h b/clock-arch.h
index 06cf79f68..2d5426ac6 100644
--- a/clock-arch.h
+++ b/clock-arch.h
@@ -37,6 +37,6 @@
 #include <stdint.h>
 
 typedef uint32_t clock_time_t;
-#define CLOCK_CONF_SECOND 100
+#define CLOCK_CONF_SECOND SYS_TICK_HZ
 
 #endif /* __CLOCK_ARCH_H__ */
diff --git a/clock.h b/clock.h
index 4238a9d68..14bb0f60e 100644
--- a/clock.h
+++ b/clock.h
@@ -74,7 +74,12 @@ void clock_init(void);
  */
 inline clock_time_t clock_time(void)
 {
-  return ticks;
+  clock_time_t t;
+
+  do {
+    t = ticks;
+  } while ((uint8_t)t != (uint8_t)ticks);
+  return t;
 }
 
 /**
diff --git a/timer.c b/timer.c
index fd1531c51..6c686acf1 100644
--- a/timer.c
+++ b/timer.c
@@ -48,9 +48,6 @@
 #include "clock.h"
 #include "timer.h"
 
-#pragma codeseg BANK1
-#pragma constseg BANK1
-
 /*---------------------------------------------------------------------------*/
 /**
  * Set a timer.

From 90d65631238d239f4e8f0e930a5800c30156297c Mon Sep 17 00:00:00 2001
From: d00f <8052722+DrDoof@users.noreply.github.com>
Date: Mon, 2 Nov 2026 08:30:00 +0100
Subject: [PATCH 03/20] timer: keep the timers in 16 bits

The longest wait in the firmware is the 30 s between LLDP frames, well
inside the 327 s a 16-bit tick count covers at 200 Hz, so a timer needs
half the xdata and compares two bytes instead of four on the 8051.
clock_time() moves into timer.c as nothing else reads it; it still reads
the counter again until the low byte agrees, since the tick interrupt
can split a load between the bytes.
