 #include <stdint.h>
 #include <stdbool.h>
 
-#define SYS_TICK_HZ 200
+#define SYS_TICK_HZ CLOCK_CONF_SECOND
 
 /* Timers of the main loop count system ticks, not loop passes: a pass is as
  * long as the packets it handles, and since #483 the loop no longer sleeps
diff --git a/rtlplayground.c b/rtlplayground.c
index a3213e4e7..e8ce5063b 100644
--- a/rtlplayground.c
+++ b/rtlplayground.c
@@ -75,8 +75,6 @@ void crc16_bank1(__xdata uint8_t *v) __naked;
    - T_TIMER_DIV12_OVERFLOW = F_SYS / DIV12 / 1..65536 = 125MHz / 12 / 1..65536 = 10.42 MHz .. 158.9 Hz
    Selecting dividor 12 settings to get lowest timer tick posiable which is already high.
 */
-#define SYS_TICK_HZ 200
-
 #define TIMER2_DIV (CLOCK_HZ / 12 / SYS_TICK_HZ)
 #if TIMER2_DIV > 0xFFFF
 #error "SYS_TICK_HZ to low, must be >= 159"

From f7a747aaa276b36a296a709ef2e929ed5737979c Mon Sep 17 00:00:00 2001
From: DrDoof <8052722+DrDoof@users.noreply.github.com>
Date: Fri, 30 Oct 2026 16:19:05 +0100
Subject: [PATCH 05/20] main loop: step SFP, STP and the second from timers

The SFP poll, the STP step and the once-a-second block each kept a byte
of the tick count and compared against it with TICKS_DUE; the second
also had the interrupt count ticks for it. They now wait on periodic
timers, reset by their interval so a stall still steps STP up to
STP_CATCH_UP times and then keeps phase. The STP timer belongs to
rtl837x_stp.c and starts with stp_setup(), so enabling STP after a
long time off does not replay the time it was off.
