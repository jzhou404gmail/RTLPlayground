From 7ee548c964c62720efcfb6204fdba58849fb1079 Mon Sep 17 00:00:00 2001
From: "Luca S." <luca.salvestrini@rozro.com>
Date: Sat, 7 Nov 2026 09:05:22 +0100
Subject: [PATCH 5/5] Do not touch "rtlplayground.bin" is OUTPUT is set

---
 Makefile  | 2 --
 README.md | 2 ++
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 40835bf42..acd24bc82 100644
--- a/Makefile
+++ b/Makefile
@@ -285,8 +285,6 @@ $(OUTPUT): $(BUILDDIR)/rtlplayground.img $(CONFIG) $(CONFIG_STAMP) | tools
 	tools/$(BUILDDIR)/crc_calculator -u "$@"
 	if [ "$(OUTPUT)" = "$(BUILDDIR)/rtlplayground-$(FILENAME_EXTENSION).bin" ]; then \
 		ln -sf $(MACHINE)/rtlplayground-$(FILENAME_EXTENSION).bin "$(BUILDDIR)/../rtlplayground.bin"; \
-	else \
-		cp -f "$(OUTPUT)" "$(BUILDDIR)/../rtlplayground.bin"; \
 	fi
 
 .PHONY: clean distclean all $(SUBDIRS) $(SUBDIRSCLEAN) create_build_dir
diff --git a/README.md b/README.md
index 98d5f7ca5..152252ed6 100644
--- a/README.md
+++ b/README.md
@@ -164,6 +164,8 @@ To set the complete path and file name at once, use `OUTPUT`:
 ```
 make MACHINE=DEFAULT_8C_1SFP OUTPUT=/tmp/firmware/my-switch.bin
 ```
+When `OUTPUT` is a custom path, `output/rtlplayground.bin` is left untouched:
+only the default build updates that symlink (and the installer uses it).
 Without overrides the image is `output/<machine>/rtlplayground-v<version>-<git>-<machine>.bin`.
 `BUILDDIR` still selects where intermediate objects and tools are written.
 
